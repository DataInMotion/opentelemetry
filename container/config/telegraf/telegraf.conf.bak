# =============================================================================
# Telegraf — MQTT -> OpenTelemetry bridge
# =============================================================================
# The OpenTelemetry Collector (contrib 0.148.0) has no MQTT receiver, so this
# Telegraf instance subscribes to the existing broker(s) and fans the JSON
# messages out into the stack:
#
#   numeric JSON fields  --(OTLP/gRPC)-->  otel-collector:4317  -->  Prometheus
#   raw JSON payloads     --(HTTP push)-->  loki:3100            -->  Loki
#
# Logs go straight to Loki because Loki has no MQTT input and Telegraf's
# opentelemetry output can only emit metrics (not OTLP logs).
#
# Broker connection + credentials come from the environment — see
# config/telegraf/secret.env (gitignored; copy from secret.env.example).
# Topic filters are NOT secret and are set directly below — edit to taste.
# MQTT wildcards: '+' = one level, '#' = the rest.
# =============================================================================

[agent]
  interval = "10s"
  flush_interval = "10s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  omit_hostname = false

# Attributes attached to every metric/log. deployment_environment mirrors the
# collector's resource processor so MQTT data lines up with OTLP data.
[global_tags]
  deployment_environment = "development"
  source = "mqtt"

# -----------------------------------------------------------------------------
# METRICS — parse JSON, emit the numeric fields as metrics
# -----------------------------------------------------------------------------
[[inputs.mqtt_consumer]]
  name_override = "mqtt"
  servers = ["${MQTT_URL}"]            # e.g. "tcp://broker:1883" or "ssl://broker:8883"
  username = "${MQTT_USERNAME}"
  password = "${MQTT_PASSWORD}"
  client_id = "telegraf-otel-metrics"
  qos = 0
  topics = [
    "#",                               # TODO: replace with your telemetry topic(s)
  ]
  topic_tag = "topic"                  # store the source topic as a tag/label

  data_format = "json"                 # numeric JSON fields become metric fields
  # tag_keys = ["device", "location"]  # promote selected JSON keys to tags (labels)
  # json_string_fields = ["status"]    # keep selected string fields (else dropped)
  # json_time_key = "timestamp"        # use a payload field as the timestamp
  # json_time_format = "unix"          # ...and its format

[[outputs.opentelemetry]]
  service_address = "otel-collector:4317"
  namepass = ["mqtt"]

# -----------------------------------------------------------------------------
# LOGS — keep the raw payload, push straight to Loki
# -----------------------------------------------------------------------------
[[inputs.mqtt_consumer]]
  name_override = "mqtt_log"
  servers = ["${MQTT_URL}"]
  username = "${MQTT_USERNAME}"
  password = "${MQTT_PASSWORD}"
  client_id = "telegraf-otel-logs"
  qos = 0
  topics = [
    "#",                               # TODO: same topic(s) as above (or a subset)
  ]
  topic_tag = "topic"

  data_format = "value"                # keep the whole payload...
  data_type = "string"                 # ...as the field "value"

[[outputs.loki]]
  domain = "http://loki:3100"          # Loki push API base (auth disabled -> tenant "fake")
  namepass = ["mqtt_log"]
  gzip_request = true
