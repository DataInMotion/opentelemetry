# MQTT broker connection for the Telegraf -> OpenTelemetry bridge.
# Copy this file to secret.env (gitignored) and fill in real values.
#
#   cp secret.env.example secret.env
#
# Telegraf reads these as ${MQTT_URL} / ${MQTT_USERNAME} / ${MQTT_PASSWORD}
# in telegraf.conf. Topic filters are NOT here — set them in telegraf.conf.

# Broker URL. Use tcp:// for plain (1883) or ssl:// for TLS (8883).
MQTT_URL=tcp://your-broker.example.com:1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme
